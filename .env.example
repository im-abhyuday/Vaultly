# ==============================================================================
# TenantRAG Environment Configuration
# ==============================================================================

# General Application Settings
PROJECT_NAME=TenantRAG
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database (with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tenantrag
POSTGRES_PASSWORD=tenantrag_secret
POSTGRES_DB=tenantrag
# Computed default: postgresql+asyncpg://tenantrag:tenantrag_secret@localhost:5432/tenantrag
DATABASE_URL=postgresql+asyncpg://tenantrag:tenantrag_secret@localhost:5432/tenantrag

# Redis (Semantic Cache & Rate Limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=86400
REDIS_SIMILARITY_THRESHOLD=0.95

# Kafka / Redpanda Message Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CONSUMER_GROUP_PREFIX=tenantrag

# Authentication & Security
JWT_SECRET_KEY=dev_secret_key_change_me_in_production_min_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Embeddings & Vector Search
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER_DEFAULT=true

# LLM Configuration (Provider-agnostic: "openai" or "ollama")
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=not-needed-for-ollama
LLM_MODEL=llama3:8b
LLM_TEMPERATURE=0.0

# Ingestion & Chunking Defaults
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
