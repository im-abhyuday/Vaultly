# ==============================================================================
# Vaultly Environment Configuration
# ==============================================================================

# General Application Settings
PROJECT_NAME=Vaultly
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database (with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tenantrag
POSTGRES_PASSWORD=tenantrag_secret
POSTGRES_DB=tenantrag
APP_DB_USER=tenantrag_app
APP_DB_PASSWORD=tenantrag_app_secret

# Migration role (owner/superuser, used exclusively by Alembic)
MIGRATION_DATABASE_URL=postgresql+asyncpg://tenantrag:tenantrag_secret@localhost:5432/tenantrag

# Runtime role (NOSUPERUSER, NOBYPASSRLS, used by API and worker)
DATABASE_URL=postgresql+asyncpg://tenantrag_app:tenantrag_app_secret@localhost:5432/tenantrag

# Redis (Semantic Cache & Rate Limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=86400
REDIS_SIMILARITY_THRESHOLD=0.95

# Kafka / Redpanda Message Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CONSUMER_GROUP_PREFIX=vaultly

# Authentication & Security
JWT_SECRET_KEY=dev_secret_key_change_me_in_production_min_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage & Upload Limits
MAX_UPLOAD_MB=25
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage

# Embeddings & Vector Search
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Ingestion & Chunking Defaults
DEFAULT_CHUNK_SIZE_TOKENS=256
DEFAULT_CHUNK_OVERLAP_TOKENS=32
DEFAULT_CHUNK_SIZE=256
DEFAULT_CHUNK_OVERLAP=32
MAX_PAGES_PER_DOC=500
MAX_EXTRACTED_CHARS=5000000
MAX_CHUNKS_PER_DOC=2000

# Worker & Outbox Settings
WORKER_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_RETENTION_DAYS=7
KAFKA_TOPIC_PREFIX=vaultly

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER_DEFAULT=true

# LLM Configuration (Provider-agnostic: "openai" or "ollama")
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=not-needed-for-ollama
LLM_MODEL=llama3:8b
LLM_TEMPERATURE=0.0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
